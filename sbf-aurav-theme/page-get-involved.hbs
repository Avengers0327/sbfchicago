{{!< default}}
{{!-- Get Involved in three parts: the ways to get involved (the page's opener, with its main heading),
     what a packing day looks like, and youth leadership with the volunteer hours and past leaders.
     Then partners and one sign-up form for volunteers and youth leaders. --}}
{{#post}}
    <article class="band-page-plain ways-first">
        <div class="gh-canvas gh-content">{{content}}</div>
    </article>
    {{> "more-ways"}}
    {{> "packing-day"}}
    {{> "youth-lead"}}
    {{> "signup-form" eyebrow="Sign up" heading="Save your spot at the next packing event" note="Tell us you are coming, whether you need volunteer hours, and if you would like to donate food items. To lead an event, answer yes to becoming a youth leader. Youth leader spots are not guaranteed, and you need to have joined an SBF packing event before."}}
{{/post}}
