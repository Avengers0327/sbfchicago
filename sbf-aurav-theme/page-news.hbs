{{!< default}}
{{!-- News: milestones, press and partner quotes, as a timeline. Content comes from the In the News
     page; dated entries become the timeline via assets/js/site.js. --}}
{{#post}}
<article class="band-page-plain">
    <header class="page-hero">
        <div class="container">
            <p class="t-eyebrow">Milestones and press</p>
            <h1 class="t-h1">News</h1>
            <p class="t-body-lg">What we've been up to.</p>
        </div>
    </header>

    <section class="page-section events-news page-in-the-news" id="milestones" aria-label="Milestones and press">
        {{#get "pages" filter="slug:in-the-news" limit="1"}}
            {{#foreach pages}}<div class="gh-canvas gh-content">{{content}}</div>{{/foreach}}
        {{/get}}
    </section>
</article>
{{/post}}
