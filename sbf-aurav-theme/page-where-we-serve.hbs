{{!< default}}
{{!-- Where We Serve: two cities, one mission. Chicago covers two kinds of projects (meals for
     neighbors facing homelessness, weekend meals for two high schools), upcoming dates and the
     four ways to help; India lists its projects. The static build (build/build.js) places each
     block of the Chicago page's content under the right heading.
     Content comes from the Chicago Projects and India Projects pages; India's project list
     becomes cards via assets/js/site.js. --}}
{{#post}}
<article class="band-page-plain">
    <header class="page-hero">
        <div class="container">
            <p class="t-eyebrow">Two cities, one mission</p>
            <h1 class="t-h1">Where We Serve</h1>
            <p class="t-body-lg">Local hearts. Global impact.</p>
            {{> "serve-cities"}}
        </div>
    </header>

    <section class="page-section serve-city band-page-chicago" id="chicago" aria-labelledby="chicago-title">
        <div class="serve-city-head band-chicago">
            <div class="container">
                <p class="t-eyebrow">Chicagoland</p>
                <h2 class="t-h1" id="chicago-title">Chicago Projects</h2>
            </div>
        </div>
        {{> "serve-category" id="homeless-meals" eyebrow="Chicagoland · most of what we pack" title="Meals for neighbors facing homelessness" sub="Sandwiches and brown bags for people facing homelessness, poverty or crisis in Chicagoland, delivered with our partners."}}
        {{#get "pages" filter="slug:who-we-serve-chicago" limit="1"}}
            {{#foreach pages}}<div class="gh-canvas gh-content">{{content}}</div>{{/foreach}}
        {{/get}}
        {{> "chicago-deliveries"}}
        {{> "serve-category" id="weekend-meals" eyebrow="Palatine & Hoffman Estates" title="Weekend meals for two high schools" sub="Weekend meal bags for students at Palatine and Hoffman Estates High Schools, who have school lunch on weekdays and no school meal on weekends."}}
        {{> "weekend-gap"}}
        {{> "upcoming-events"}}
        {{> "help-cards"}}
    </section>

    <section class="page-section serve-city band-page-india page-who-we-serve-india" id="india" aria-labelledby="india-title">
        <div class="serve-city-head band-india">
            <div class="container">
                <p class="t-eyebrow">India</p>
                <h2 class="t-h1" id="india-title">India Projects</h2>
                <p class="t-body-lg">A blind school, two slum schools, Labor Chowk, Apna Ghar, an orphanage in Shirdi, feeding cows and an animal rescue shelter, across New Delhi, Gurugram, Pratapgarh and Shirdi.</p>
            </div>
        </div>
        {{#get "pages" filter="slug:who-we-serve-india" limit="1"}}
            {{#foreach pages}}<div class="gh-canvas gh-content">{{content}}</div>{{/foreach}}
        {{/get}}
    </section>
</article>
{{/post}}
{{> "donate-panel"}}
