{{!-- Chicago Projects hero: the year's impact in one row (numbers from build/stats.json) --}}
<div class="hero-stats">
    <ul class="hero-stat-list" role="list">
        <li><span class="t-stat">{{stats.chicago_meals}}</span><span>Meals</span></li>
        <li><span class="t-stat">{{stats.sandwiches}}</span><span>Peanut butter sandwiches</span></li>
        <li><span class="t-stat">{{stats.brown_bags}}</span><span>Brown bags with sandwiches, chips, granola bars and more</span></li>
        <li><span class="t-stat">{{stats.weekend_bags}}</span><span>Bags with non-perishable items</span></li>
    </ul>
    <p class="t-small t-muted">2026 Chicago food drive impact, {{stats.period}}</p>
</div>
