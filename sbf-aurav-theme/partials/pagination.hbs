<nav class="pagination" aria-label="Pagination">
    {{#if prev}}<a class="btn btn-secondary btn-sm" href="{{page_url prev}}">Newer</a>{{else}}<span></span>{{/if}}
    <span class="t-small">Page {{page}} of {{pages}}</span>
    {{#if next}}<a class="btn btn-secondary btn-sm" href="{{page_url next}}">Older</a>{{else}}<span></span>{{/if}}
</nav>
