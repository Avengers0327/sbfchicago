{{!-- Where We Serve: the four ways to help, as cards (replaces the old link previews) --}}
<section class="help-cards" id="help" aria-labelledby="help-title">
    <div class="container">
        <div class="ways-head">
            <p class="t-eyebrow">Help with our mission</p>
            <h2 class="t-h1" id="help-title">Want to help make an impact?</h2>
        </div>
        <ul class="ways-grid" role="list">
            <li class="way-card">
                <span class="way-icon"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/><path d="M3 4h2l2.4 11h10.2L20 8H6.2"/></svg></span>
                <h3 class="t-h3">Amazon Wishlist</h3>
                <p>Buy items for our next food drive from our Amazon wish list.</p>
                <a class="link-arrow" href="{{@custom.wishlist_url}}">Open the wishlist</a>
            </li>
            <li class="way-card">
                <span class="way-icon"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14l-1.2 12.5H6.2L5 8z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/></svg></span>
                <h3 class="t-h3">Items Needed</h3>
                <p>Sign up for the items needed for the next food drive.</p>
                <a class="link-arrow" href="{{@site.url}}/give/#items">See items needed</a>
            </li>
            <li class="way-card">
                <span class="way-icon"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/></svg></span>
                <h3 class="t-h3">Donations</h3>
                <p>Help us provide meals. Donate online, or send Zelle to sbfchicago@gmail.com.</p>
                <a class="link-arrow" href="{{@custom.donate_url}}">Donate</a>
            </li>
            <li class="way-card">
                <span class="way-icon"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/></svg></span>
                <h3 class="t-h3">Get Involved</h3>
                <p>Volunteer at a packing event, and get volunteer hours if you need them.</p>
                <a class="link-arrow" href="{{@site.url}}/get-involved/">Get involved</a>
            </li>
        </ul>
    </div>
</section>
