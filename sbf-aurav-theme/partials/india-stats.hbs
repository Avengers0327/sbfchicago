{{!-- India Projects hero: the year's impact in one row (numbers from build/stats.json) --}}
<div class="hero-stats">
    <ul class="hero-stat-list" role="list">
        <li><span class="t-stat">{{stats.india_meals}}</span><span>Meals</span></li>
        <li><span class="t-stat">{{stats.india_drives}}</span><span>Food drives</span></li>
        <li><span class="t-stat">{{stats.india_orgs}}</span><span>Organizations we feed through</span></li>
        <li><span class="t-stat">{{stats.india_ration_kits}}</span><span>Meal kits in our ration drive</span></li>
    </ul>
    <p class="t-small t-muted">2026 India food drive impact, {{stats.period}}</p>
</div>
