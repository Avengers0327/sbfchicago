{{!-- Volunteer hours for every volunteer: regular and lead roles side by side --}}
<section class="page-section volunteer-hours" id="volunteer-hours" aria-labelledby="hours-title">
    <div class="container">
        <div class="section-head">
            <div class="stack">
                <p class="t-eyebrow">Volunteer hours</p>
                <h2 class="t-h1" id="hours-title">Earn hours for your time</h2>
                <p class="t-body-lg">Volunteer Hours will be provided to students for Chicago food packing events as follows:</p>
            </div>
        </div>
        <div class="hours">
            <div class="hours-tile">
                <p class="t-eyebrow">Regular</p>
                <p class="t-stat">2<small>hours</small></p>
                <ul class="duties" role="list">
                    <li>Helping set-up/clean-up</li>
                    <li>Packing items</li>
                    <li>Buying food items</li>
                </ul>
            </div>
            <div class="hours-tile is-lead">
                <p class="t-eyebrow">Leads</p>
                <p class="t-stat">4<small>hours</small></p>
                <ul class="duties" role="list">
                    <li>Developing presentations</li>
                    <li>Marketing event</li>
                    <li>Recruiting for event</li>
                    <li>Buying food items</li>
                    <li>Helping set-up/clean-up</li>
                    <li>Supervising on day of event</li>
                </ul>
                <a class="link-arrow" href="#youth-leadership">Become a youth leader</a>
            </div>
        </div>
    </div>
</section>
