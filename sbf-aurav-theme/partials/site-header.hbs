<header class="site-header" id="site-header">
    <div class="container site-header-top">
        <a class="brand" href="{{@site.url}}">
            {{#if @site.logo}}
                <img class="brand-logo" src="{{img_url @site.logo size="s"}}" alt="{{@site.title}}">
            {{else}}
                <img class="brand-mark" src="{{#if @site.icon}}{{img_url @site.icon size="xs"}}{{else}}{{asset "images/sbf-logo.jpg"}}{{/if}}" alt="" width="44" height="44">
                <span class="brand-name">{{@site.title}}</span>
            {{/if}}
        </a>

        <div class="header-actions">
            {{#unless @member}}
                {{#if @site.members_enabled}}
                    <a class="member-link" href="#/portal/signin" data-portal="signin">Sign in</a>
                    {{#unless @site.members_invite_only}}
                        <a class="btn btn-secondary btn-sm subscribe-btn" href="#/portal/signup" data-portal="signup">Subscribe</a>
                    {{/unless}}
                {{/if}}
            {{else}}
                <a class="member-link" href="#/portal/account" data-portal="account">Account</a>
            {{/unless}}
            <a class="btn btn-primary btn-sm header-donate" href="{{@custom.donate_url}}">Donate</a>
            <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                Menu
            </button>
        </div>
    </div>

    <nav class="site-nav" id="site-nav" aria-label="Main">
        <div class="container">
            {{navigation}}
            {{#unless @member}}{{#if @site.members_enabled}}
                <div class="nav-members">
                    <a href="#/portal/signin" data-portal="signin">Sign in</a>
                    {{#unless @site.members_invite_only}}<a href="#/portal/signup" data-portal="signup">Subscribe</a>{{/unless}}
                </div>
            {{/if}}{{/unless}}
        </div>
    </nav>
</header>
