{{!-- Give: the ways to give, each pointing at its part of the page (or Membership) --}}
<section class="give-choose" aria-label="Ways to give">
    <div class="container">
        <ul class="give-choices" role="list">
            <li class="give-choice">
                <p class="t-eyebrow">Give money</p>
                <h2 class="t-h3">Donate online with Zeffy</h2>
                <p>Give once, monthly, quarterly or yearly. Zeffy is free for SBF, so your gift goes to meals.</p>
                <a class="link-arrow" href="#donate">Donate</a>
            </li>
            <li class="give-choice">
                <p class="t-eyebrow">Zelle</p>
                <h2 class="t-h3">Send it with Zelle</h2>
                <p>From your bank's app, send to sbfchicago@gmail.com.</p>
                <a class="link-arrow" href="#zelle">Give by Zelle</a>
            </li>
            <li class="give-choice">
                <p class="t-eyebrow">Give food</p>
                <h2 class="t-h3">Ship it, or bring it</h2>
                <p>Every packing event needs bread, peanut butter, jelly, chips and more.</p>
                <a class="link-arrow" href="#items">Give items</a>
            </li>
            <li class="give-choice">
                <p class="t-eyebrow">Give time</p>
                <h2 class="t-h3">Volunteer at a packing event</h2>
                <p>Pack meals with us once a month in Schaumburg. Everyone is welcome, and students earn volunteer hours.</p>
                <a class="link-arrow" href="#time">Give time</a>
            </li>
            <li class="give-choice">
                <p class="t-eyebrow">Give monthly</p>
                <h2 class="t-h3">Become a member</h2>
                <p>Advocate and Champion plans, with coaching, recognition and mentorship for our youth leaders.</p>
                <a class="link-arrow" href="{{@site.url}}/membership/">See the plans</a>
            </li>
        </ul>
    </div>
</section>
