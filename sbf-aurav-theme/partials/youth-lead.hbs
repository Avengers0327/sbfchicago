{{!-- Youth leadership on Get Involved: what leads do, then the wall of past leaders.
     The wall comes from the Youth Leaders page, so editors keep updating that page. --}}
<section class="page-section youth-lead page-youth-leaders" id="youth-leadership" aria-labelledby="youth-title">
    <div class="container">
        <div class="section-head">
            <div class="stack">
                <p class="t-eyebrow">Youth leadership</p>
                <h2 class="t-h1" id="youth-title">Lead an event</h2>
                <p class="t-body-lg">Each month, student youth leaders help run our food packing event: presenting, recruiting, buying food and supervising on the day. Leads earn 4 volunteer hours.</p>
                <p>We provide many opportunities for our young leaders to come and help with this initiative.</p>
            </div>
            <a class="btn btn-secondary" href="#sign-up">Sign up to lead an event</a>
        </div>
    </div>
    {{#get "pages" filter="slug:youth-leaders" limit="1"}}
        {{#foreach pages}}<div class="gh-canvas gh-content">{{content}}</div>{{/foreach}}
    {{/get}}
</section>
