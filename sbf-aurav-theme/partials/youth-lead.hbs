{{!-- Youth leadership on Get Involved: what leads do, the volunteer hours, then the wall of past leaders.
     The wall comes from the Youth Leaders page, so editors keep updating that page. --}}
<section class="page-section youth-lead page-youth-leaders" id="youth-leadership" aria-labelledby="youth-title">
    <div class="container">
        <div class="section-head">
            <div class="stack">
                <p class="t-eyebrow">Youth leadership</p>
                <h2 class="t-h1" id="youth-title">Lead an event</h2>
                <p class="t-body-lg">Each month, student youth leaders help run our food packing event: presenting, recruiting, buying food and supervising on the day. Leads earn 4 volunteer hours.</p>
                <p>We provide many opportunities for our young leaders to come and help with this initiative.</p>
            </div>
            <a class="btn btn-secondary" href="#sign-up">Sign up to lead an event</a>
        </div>
    </div>
    <div class="container youth-hours" id="volunteer-hours">
        <h3 class="t-h3">Volunteer hours</h3>
        <p>Volunteer Hours will be provided to students for Chicago food packing events as follows:</p>
        <div class="hours">
            <div class="hours-tile">
                <p class="t-eyebrow">Regular</p>
                <p class="t-stat">2<small>hours</small></p>
                <ul class="duties" role="list">
                    <li>Helping set-up/clean-up</li>
                    <li>Packing items</li>
                    <li>Buying food items</li>
                </ul>
            </div>
            <div class="hours-tile is-lead">
                <p class="t-eyebrow">Leads</p>
                <p class="t-stat">4<small>hours</small></p>
                <ul class="duties" role="list">
                    <li>Developing presentations</li>
                    <li>Marketing event</li>
                    <li>Recruiting for event</li>
                    <li>Buying food items</li>
                    <li>Helping set-up/clean-up</li>
                    <li>Supervising on day of event</li>
                </ul>
            </div>
        </div>
    </div>
    {{#get "pages" filter="slug:youth-leaders" limit="1"}}
        {{#foreach pages}}<div class="gh-canvas gh-content">{{content}}</div>{{/foreach}}
    {{/get}}
</section>
