{{!< default}}
{{!-- Homepage: only what a first-time visitor needs. Who we feed, how it works, how to join,
     when to show up, and a way to give. The detail lives on the other pages:
     Where We Serve (the cities, the weekend gap, partners), Get Involved, Give, News & Events. --}}

<header class="page-hero page-hero-split home-hero" aria-labelledby="hero-title">
    <div class="container">
        <div class="hero-copy">
            <p class="t-eyebrow">Who goes hungry near us</p>
            <h1 class="t-display" id="hero-title">{{@custom.hero_headline}}</h1>
            <p class="t-body-lg">{{@custom.hero_subcopy}}</p>
            <div class="hero-actions">
                <a class="btn btn-primary" href="{{@custom.donate_url}}">Donate now</a>
                <a class="scroll-cue" href="#how-we-help">See how we help</a>
            </div>
            <p class="t-small t-muted">Short on time? Donate, and the SBF team buys the food on your behalf.</p>
        </div>
        <figure class="hero-photo">
            {{#if @custom.hero_image}}
                <img src="{{img_url @custom.hero_image size="l"}}" alt="SBF Chicago volunteers handing out meals">
            {{else}}
                <img src="{{@site.url}}/content/images/size/w1000/2026/08/WhatsApp-Image-2026-08-10-at-10.05.13-PM.jpeg" alt="SBF volunteers handing out brown bags in the hallway of the Annex men's hotel, a homeless shelter in Chicago">
            {{/if}}
            <figcaption>Serving brown bags at the Annex men's hotel, a homeless shelter in Chicago, August 2026.</figcaption>
        </figure>
    </div>
</header>

{{> "facts-strip"}}

<section class="act" id="how-we-help" aria-labelledby="solve-title">
    <div class="container">
        <div class="act-head">
            <p class="t-eyebrow">How SBF closes the gap</p>
            <h2 class="t-h1" id="solve-title">Once a month, we pack the meals that reach all of them.</h2>
        </div>

        <ol class="steps" aria-label="How it works">
            <li class="step">
                <p class="t-eyebrow">Step 1 &middot; You give</p>
                <h3 class="t-h3">Donations become groceries</h3>
                <p>Give through our donation form or Zelle, or send items from our <a href="{{@custom.wishlist_url}}">Amazon Wishlist</a>. The SBF team buys food on your behalf.</p>
            </li>
            <li class="step">
                <p class="t-eyebrow">Step 2 &middot; We pack</p>
                <h3 class="t-h3">Up to 1,200+ meals in one afternoon</h3>
                <p>At our recent events, 45 to 60+ volunteers pack sandwiches, brown bags and weekend meal bags at National India Hub in Schaumburg.</p>
            </li>
            <li class="step">
                <p class="t-eyebrow">Step 3 &middot; Partners deliver</p>
                <h3 class="t-h3">Meals reach people who need them</h3>
                <p>The Night Ministry, Food For Friends and Blessings in a Backpack bring the meals to people facing homelessness and to students at Palatine and Hoffman Estates High Schools.</p>
            </li>
        </ol>

        <p class="solve-more"><a class="link-arrow" href="{{@site.url}}/where-we-serve/">See where we serve</a></p>
    </div>
</section>

{{> "home-ways"}}

{{> "upcoming-events"}}

<section class="post-cta next-event" aria-labelledby="next-title">
    <div class="container">
        <div class="cta-panel band-navy on-navy">
            <div class="stack">
                <p class="t-eyebrow">Can't make it?</p>
                <h2 class="t-h1" id="next-title">Your donation still fills the weekend.</h2>
                <p class="t-body">We also accept Zelle at sbfchicago@gmail.com, or <a class="wishlist-link" href="{{@custom.wishlist_url}}">send items from the Amazon Wishlist</a>.</p>
            </div>
            <div class="cta-actions">
                <a class="btn btn-primary" href="{{@custom.donate_url}}">Donate</a>
                <a class="btn btn-secondary" href="{{@custom.volunteer_url}}">Sign up to pack</a>
            </div>
        </div>
    </div>
</section>
